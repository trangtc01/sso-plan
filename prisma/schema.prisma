generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADED
  QUEUED
  UPLOADING
  PUBLISHING
  PUBLISHED
  SAVING_DRAFT
  VERIFYING
  DRAFT_SAVED
  FAILED
  LOGIN_REQUIRED
  AMBIGUOUS
}

enum Platform {
  FACEBOOK
  YOUTUBE
  TIKTOK
}

enum PublishMode {
  DRAFT
  PUBLIC
}

enum FacebookContentType {
  REEL
  VIDEO_POST
}

enum RenderStatus {
  QUEUED
  VOICE_GENERATING
  VOICE_READY
  RENDERING
  READY
  FAILED
}

enum PublishStatus {
  QUEUED
  SCHEDULED
  WAITING_SOURCE
  WAITING_TIKTOK_SOURCE
  READY_TO_RUN
  PUBLISHING
  PUBLISHED
  FAILED
  AMBIGUOUS
}

model Video {
  id           String       @id @default(uuid())
  title        String
  sourcePath   String
  description  String       @default("")
  subtitlePath String?
  outputPath   String?
  tiktokPublishedUrl String?
  tiktokDownloadedPath String?
  hashtags     String[]
  status       VideoStatus  @default(UPLOADED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  jobs         UploadJob[]
  renderJobs   RenderJob[]
  publishJobs  PublishJob[]
}

model RenderJob {
  id           String       @id @default(uuid())
  videoId      String
  status       RenderStatus @default(QUEUED)
  voicePath    String?
  musicPath    String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model PublishJob {
  id                  String               @id @default(uuid())
  videoId             String
  platform            Platform
  publishMode         PublishMode          @default(PUBLIC)
  facebookContentType FacebookContentType?
  useTikTokSource     Boolean              @default(false)
  publishTime         DateTime?
  status              PublishStatus        @default(QUEUED)
  retryCount          Int                  @default(0)
  errorMessage        String?
  response            Json?
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime             @default(now())
  video               Video                @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([platform, status, publishTime])
}

model PlatformAccount {
  id           String   @id @default(uuid())
  platform     Platform
  displayName  String
  credential   String
  refreshToken String?
  expireTime   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([platform, displayName])
}

model Music {
  id         String   @id @default(uuid())
  title      String
  sourcePath String
  durationMs Int?
  createdAt  DateTime @default(now())
}

model UploadJob {
  id           String      @id @default(uuid())
  videoId      String
  status       VideoStatus @default(QUEUED)
  publishMode  PublishMode @default(DRAFT)
  useSound     Boolean     @default(true)
  publishTime  DateTime?
  retryCount   Int         @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime    @default(now())
  video        Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  attempts     UploadAttempt[]
}

model UploadAttempt {
  id             String      @id @default(uuid())
  jobId          String
  number         Int
  status         VideoStatus @default(QUEUED)
  logPath        String?
  screenshotPath String?
  errorMessage   String?
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  job            UploadJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, number])
}
