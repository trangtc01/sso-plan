DATABASE_URL="postgresql://truongtrang:postgres@localhost:5432/video_automation?schema=public"
REDIS_URL="redis://localhost:6379"
VIDEO_STORAGE_DIR="./.tiktok-automation/uploads"
TIKTOK_PROFILE_DIR="/Users/truongtrang/Library/Application Support/Google/Chrome"
TIKTOK_CHROME_PROFILE_DIRECTORY="Default"
TIKTOK_ARTIFACT_DIR="./.tiktok-automation/artifacts"

# Facebook Page / Reels
FB_PAGE_ACCESS_TOKEN=""
FB_PAGE_ID=""
FB_GRAPH_VERSION="v25.0"
FB_DEFAULT_VIDEO_STATE="DRAFT"

# YouTube via Playwright / YouTube Studio
# IMPORTANT: dedicated user-data dir, NOT your normal Chrome User Data directory.
YOUTUBE_PROFILE_DIR="~/.sso-plan/youtube-profile"
YOUTUBE_CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
YOUTUBE_CHROME_PROFILE_DIRECTORY="Default"
YOUTUBE_ARTIFACT_DIR="./.social-automation/youtube-artifacts"
YOUTUBE_UPLOAD_URL="https://studio.youtube.com"
YOUTUBE_DEFAULT_PRIVACY="public"
YOUTUBE_DEFAULT_MADE_FOR_KIDS="false"
YOUTUBE_NAVIGATION_TIMEOUT_MS="60000"
YOUTUBE_UPLOAD_TIMEOUT_MS="600000"

# Playwright attaches to real Chrome over CDP
YOUTUBE_CDP_PORT="9222"
